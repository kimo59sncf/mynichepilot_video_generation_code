# =============================================================================
# MyNichePilot — Fichiers ignorés par Git
# =============================================================================

# --- Vidéos et audio générés (lourds, reproductibles via le pipeline) ---
output/
.work/

# --- Cache Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Environnements virtuels ---
venv/
.venv/
env/
.conda/

# --- Clés / configuration locale (ne jamais versionner) ---
.env
.env.local

# --- Éditeurs / OS ---
.vscode/
.idea/
Thumbs.db
.DS_Store

# --- Logs & temporaires ---
*.log
*.tmp