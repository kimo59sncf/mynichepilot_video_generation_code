# =============================================================================
# MyNichePilot — Variables d'environnement (copiez vers `.env` ou exportez-les)
# =============================================================================

# ---- Génération de contenu VARIABLE (IA) ----
# Fournisseur du script/hook/hashtags :
#   static  -> texte fixe (défaut, aucune dépendance)
#   llm     -> API Chat-Completions compatible OpenAI (recommandé)
#   saas    -> API « Social-Script-Genius » (POST /api/generate)
CONTENT_PROVIDER=static

# Sujet / thématique passée au fournisseur IA
CONTENT_TOPIC=MyNichePilot, le coach IA d'execution business pour solopreneurs

# --- Fournisseur LLM (OpenAI-compatible) ---
# Mêmes valeurs que celles de Social-Script-Genius
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Fournisseur SaaS (Social-Script-Genius) ---
# URL de base de l'API (ex: https://votre-deploiement.replit.app/api  ou  http://localhost:5001/api)
SAAS_API_URL=http://localhost:5001/api
SAAS_PLATFORM=tiktok
SAAS_DURATION=1min

# ---- Interface VIP ----
# (le port/ l'hôte peuvent être passés directement à server.py)
# PORT=8000